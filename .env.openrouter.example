# =============================================================================
# OpenRouter overlay env — append these values to your repo-root .env.
# (branch feat/openrouter: OpenRouter is the DEFAULT backend for both the
#  transcriber and the standup-extractor.)
#
# Bring the stack up with the blessed wrapper (it wires --env-file + both -f
# files for you):
#   ops/stack.sh up-lean
#
# See ops/VM-RUNBOOK.md for a full fresh-VM bring-up.
# =============================================================================

# ---- 1. Repoint Vexa at the adapter + standup hook (read by meeting-api) ----
TRANSCRIPTION_SERVICE_URL=http://transcriber:8085/v1/audio/transcriptions
TRANSCRIPTION_SERVICE_TOKEN=change-me-shared-token
POST_MEETING_HOOKS=http://standup-extractor:8086/hooks/meeting-completed
# Leave LOCAL_TRANSCRIPTION unset — the adapter replaces the local Whisper service.

# ---- 2. OpenRouter (one key, both services; distinct models) ----
OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Transcription (transcriber). OpenRouter STT returns TEXT ONLY — no word/segment
# timestamps — so the adapter synthesizes one full-chunk segment. Slugs are
# NAMESPACED (provider/model).
OPENROUTER_TRANSCRIBE_MODEL=openai/gpt-4o-transcribe

# Standup extraction (standup-extractor) chat model.
OPENROUTER_CHAT_MODEL=openai/gpt-5.5
# Only route to a provider that honors structured params (json_schema, etc.).
# Set false for non-OpenRouter OpenAI-compatible proxies that reject the
# `provider.require_parameters` routing hint.
OPENROUTER_REQUIRE_PARAMETERS=true
# gpt-5.5 is a reasoning model -> the extractor omits temperature when true.
REASONING_MODEL=true
MAX_COMPLETION_TOKENS=2000
# For a deterministic non-reasoning model instead, e.g.:
#   OPENROUTER_CHAT_MODEL=openai/gpt-4.1
#   REASONING_MODEL=false
#   LLM_TEMPERATURE=0

# Optional app-attribution headers (OpenRouter dashboard ranking only):
# OPENROUTER_REFERER=https://your-app
# OPENROUTER_TITLE=vexa

# ---- 3. Standup-extractor wiring ----
# Must EQUAL meeting-api's INTERNAL_API_SECRET — the extractor uses it to pull
# the transcript from meeting-api's internal endpoint.
INTERNAL_API_SECRET=vexa-internal-secret
# Map raw speaker labels -> canonical names (JSON). Leave unset to pass through.
# TEAM_ROSTER={"Alice Smith":"Alice","Bob":"Bob Jones"}
# Kanban push target. Leave unset -> standup-extractor logs the payload (stub).
# KANBAN_API_URL=
# KANBAN_API_KEY=

# ---- 4. Tuning (optional; defaults shown) ----
# TRANSCRIBER_TIMEOUT_S=25            # per-request transcription timeout
# EXTRACTOR_TIMEOUT_S=60             # per-request standup LLM timeout
# MAX_RETRIES=2                      # transcriber upstream retries
# RETRY_BASE_MS=500                  # transcriber retry backoff base
# BUSY_RETRY_AFTER_S=1               # Retry-After advertised on 503 (backpressure)
# DEFAULT_LANGUAGE_PROBABILITY=1.0   # synthesized when STT gives no confidence
# TRANSCRIBER_HOST_PORT=8085         # host port -> transcriber:8085
# STANDUP_EXTRACTOR_HOST_PORT=8086   # host port -> standup-extractor:8086

# ---- 5. Security (REQUIRED for any internet-exposed VM) ----
# Generate each with:  openssl rand -hex 24
# BOT_API_TOKEN guards the runtime-api scheduler (API_KEYS=${BOT_API_TOKEN});
# without it ANYONE who can reach runtime-api can schedule bot joins.
BOT_API_TOKEN=
# ADMIN_TOKEN guards the admin API (user/token creation). Do NOT keep "changeme".
ADMIN_TOKEN=
# TRANSCRIPTION_SERVICE_TOKEN is the shared secret between the bot and the
# transcriber (set above in section 1 too — keep them identical).
# TRANSCRIPTION_SERVICE_TOKEN=

# ---- 6. WARNING: do NOT set COMPOSE_FILE in .env ----
# deploy/compose/Makefile does `-include .env`, so a COMPOSE_FILE line here would
# OVERRIDE the Makefile's own internal COMPOSE_FILE and break `make` targets
# (init-db, setup-api-key, etc.). If you want bare `docker compose` to pick up
# the overlay automatically, export COMPOSE_FILE in your shell instead
# (~/.bashrc) — see ops/VM-RUNBOOK.md. `make` is immune; it sets COMPOSE_FILE
# itself. ops/stack.sh is immune; it passes -f flags explicitly.
