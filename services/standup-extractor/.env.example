# standup-extractor — environment (no secrets committed)

# LLM backend: openrouter (default) | azure | openai_compatible
MODEL_MODE=openrouter

# ---- OpenRouter (default) ----
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.5
# Route only to a provider that honors response_format (recommended for strict JSON):
OPENROUTER_REQUIRE_PARAMETERS=true
MAX_COMPLETION_TOKENS=2000
# gpt-5.5 is a reasoning model -> temperature is NOT sent. For a non-reasoning model
# (e.g. OPENROUTER_MODEL=openai/gpt-4.1) set REASONING_MODEL=false + LLM_TEMPERATURE=0.
REASONING_MODEL=true
# LLM_TEMPERATURE=0
# Optional app-attribution headers (OpenRouter dashboard ranking only):
# OPENROUTER_REFERER=https://your-app
# OPENROUTER_TITLE=vexa-standup-extractor

# ---- Azure OpenAI (ONLY when MODEL_MODE=azure) ----
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-5.5

# ---- OpenAI-compatible proxy (ONLY when MODEL_MODE=openai_compatible) ----
# OPENAI_COMPAT_BASE_URL=http://litellm:4000/v1
# OPENAI_COMPAT_API_KEY=your-proxy-key
# OPENAI_COMPAT_MODEL=gpt-5.5

# ---- Vexa internal transcript fetch ----
MEETING_API_INTERNAL_URL=http://meeting-api:8080
INTERNAL_API_SECRET=vexa-internal-secret

# ---- Speaker label -> real name map (JSON) ----
# TEAM_ROSTER={"Alice Smith":"Alice","Bob":"Bob Jones"}

# ---- Kanban (STUB — see app/kanban_client.py). Leave unset to log-only. ----
# KANBAN_API_URL=https://your-kanban.example.com/api
# KANBAN_API_KEY=your-kanban-key

# REQUEST_TIMEOUT_S=60
# LOG_LEVEL=INFO
