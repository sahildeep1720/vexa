# azure-transcriber — environment (no secrets committed)
# Default backend is OpenRouter. Azure backends remain selectable via TRANSCRIBER_MODEL.

# Backend / model selector:
#   openrouter                 (DEFAULT; OpenRouter STT — TEXT ONLY -> single full-chunk
#                               segment, NO word/segment timestamps -> coarser speaker split)
#   gpt-4o-transcribe          (Azure; verbose_json + word timestamps)
#   gpt-4o-mini-transcribe     (Azure; word timestamps, cheaper)
#   gpt-4o-transcribe-diarize  (Azure; diarized_json, segment-level only)
#   whisper-1                  (Azure)
#   MAI-Transcribe-1           (Azure Speech LLM)
TRANSCRIBER_MODEL=openrouter

# ---- OpenRouter (default backend) ----
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Namespaced slug (NOT a bare id). Other options: openai/gpt-4o-mini-transcribe,
# openai/whisper-large-v3, openai/whisper-large-v3-turbo, qwen/qwen3-asr-flash-2026-02-10.
OPENROUTER_TRANSCRIBE_MODEL=openai/gpt-4o-transcribe
# Optional app-attribution headers (OpenRouter dashboard ranking only):
# OPENROUTER_REFERER=https://your-app
# OPENROUTER_TITLE=vexa-azure-transcriber

# ---- Inbound auth (what Vexa's bot presents) ----
# If unset, falls back to TRANSCRIPTION_SERVICE_TOKEN. If neither set, auth is open.
# INBOUND_AUTH_TOKEN=your-shared-token

# ---- Azure backends (ONLY needed if TRANSCRIBER_MODEL is an Azure model) ----
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-transcribe
# AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe
# AZURE_SPEECH_ENDPOINT=https://your-speech.cognitiveservices.azure.com   # MAI only
# AZURE_SPEECH_KEY=your-speech-key
# AZURE_SPEECH_REGION=eastus

# ---- Behaviour ----
# REQUEST_TIMEOUT_S=25            # keep < the bot's 30s client timeout
# DEFAULT_LANGUAGE_PROBABILITY=1.0
# MAX_RETRIES=2
# LOG_LEVEL=INFO
