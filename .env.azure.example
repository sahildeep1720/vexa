# =============================================================================
# OpenRouter integration env — append these to your repo-root .env
# (branch feat/openrouter: OpenRouter is the DEFAULT backend for both services;
#  Azure remains available as an opt-in fallback — see section 4.)
#
# Bring the stack up with (--env-file is REQUIRED — compose reads .env from the
# FIRST -f file's dir, deploy/compose, not the repo root):
#   docker compose --env-file .env \
#     -f deploy/compose/docker-compose.yml -f docker-compose.azure.yml up -d --pull=missing
# =============================================================================

# ---- 1. Repoint Vexa at the adapter + standup hook (read by meeting-api as-is) ----
TRANSCRIPTION_SERVICE_URL=http://azure-transcriber:8085/v1/audio/transcriptions
TRANSCRIPTION_SERVICE_TOKEN=change-me-shared-token
POST_MEETING_HOOKS=http://standup-extractor:8086/hooks/meeting-completed
# Leave LOCAL_TRANSCRIPTION unset — the adapter replaces the local Whisper service.

# ---- 2. OpenRouter (DEFAULT backend for BOTH services; one key) ----
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Transcription (azure-transcriber).
#   NOTE: OpenRouter STT returns TEXT ONLY — no word/segment timestamps. The adapter
#   synthesizes one full-chunk segment, so speaker attribution is chunk-level: fine for
#   Google Meet (per-speaker capture), coarser for Teams (mixed audio). For word-level
#   splitting set TRANSCRIBER_MODEL=gpt-4o-transcribe (Azure) in section 4.
#   Slugs are NAMESPACED (provider/model).
TRANSCRIBER_MODEL=openrouter
OPENROUTER_TRANSCRIBE_MODEL=openai/gpt-4o-transcribe

# Standup extraction (standup-extractor).
MODEL_MODE=openrouter
OPENROUTER_CHAT_MODEL=openai/gpt-5.5
OPENROUTER_REQUIRE_PARAMETERS=true   # only route to a provider that honors json_schema
REASONING_MODEL=true                 # gpt-5.5 reasoning model -> no temperature
MAX_COMPLETION_TOKENS=2000
# For a deterministic non-reasoning model instead:
#   OPENROUTER_CHAT_MODEL=openai/gpt-4.1 ; REASONING_MODEL=false ; LLM_TEMPERATURE=0

# Optional app-attribution headers (OpenRouter dashboard ranking only):
# OPENROUTER_REFERER=https://your-app
# OPENROUTER_TITLE=vexa

# ---- 3. Standup-extractor wiring ----
INTERNAL_API_SECRET=vexa-internal-secret   # must equal meeting-api's
# TEAM_ROSTER={"Alice Smith":"Alice","Bob":"Bob Jones"}
# KANBAN_API_URL=          # leave unset -> standup-extractor logs the payload (stub)
# KANBAN_API_KEY=

# ---- 4. (Optional) Azure backends INSTEAD of OpenRouter ----
# Transcription with word timestamps: set TRANSCRIBER_MODEL=gpt-4o-transcribe + below.
# Standup via Azure: set MODEL_MODE=azure + AZURE_OPENAI_CHAT_DEPLOYMENT.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.5

# ---- 5. Docker socket access for runtime-api (local OrbStack: socket is root:root) ----
# DOCKER_GID=0
